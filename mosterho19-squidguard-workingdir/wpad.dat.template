function FindProxyForURL(url, host) {
    // 1. Fast string checks first (no DNS lookup required)
    if (isPlainHostName(host) ||
        dnsDomainIs(host, ".${DOMAIN_NAME}") ||
        dnsDomainIs(host, ".local") ||
        host === "localhost" ||
        host === "127.0.0.1") {
        return "DIRECT";
    }

    // 2. Resolve IP once and bypass private LAN subnets (RFC1918)
    var resolved_ip = dnsResolve(host);
    if (resolved_ip && (
        isInNet(resolved_ip, "10.0.0.0", "255.0.0.0") ||
        isInNet(resolved_ip, "172.16.0.0", "255.240.0.0") ||
        isInNet(resolved_ip, "192.168.0.0", "255.255.0.0") ||
        isInNet(resolved_ip, "127.0.0.0", "255.0.0.0"))) {
        return "DIRECT";
    }

    // 3. Send everything else to Squid
    return "PROXY ${PROXY_HOST}:${PROXY_PORT}";
}